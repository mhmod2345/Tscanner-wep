class DirScanner:
    def __init__(self, target: str, wordlist_path: str,
                 stealth: StealthEngine, threads: int = 25, timeout: int = 5):
        self.target       = target.rstrip("/")
        self.wordlist_path = wordlist_path
        self.stealth      = stealth
        self.threads      = threads
        self.timeout      = timeout
        self.found        = []
        self._scanned     = 0

    def _load(self) -> list:
        try:
            with open(self.wordlist_path) as f:
                words = [l.strip() for l in f
                         if l.strip() and not l.startswith("#")]
            info(f"Wordlist: {self.wordlist_path}  ({len(words)} paths)")
            return words
        except FileNotFoundError:
            warn(f"Wordlist not found — using built-in ({len(DEFAULT_WORDLIST)} paths)")
            return DEFAULT_WORDLIST

    def _check(self, path: str):
        url = f"{self.target}/{path}"
        self.stealth.wait()
        try:
            r = requests.get(url,
                             headers=self.stealth.headers(),
                             timeout=self.timeout,
                             verify=False,
                             allow_redirects=False)
            self._scanned += 1
            if r.status_code in (200, 204, 301, 302, 307, 403, 405):
                return {
                    "url":    url,
                    "path":   path,
                    "status": r.status_code,
                    "size":   len(r.content),
                    "server": r.headers.get("Server", ""),
                }
        except Exception:
            self._scanned += 1
        return None

    def run(self) -> list:
        section("Phase 3 — Directory & File Discovery")
        paths = self._load()
        total = len(paths)
        info(f"Scanning {total} paths  |  threads: {self.threads}  |  "
             f"stealth: {self.stealth.mode}")
        print()

        with concurrent.futures.ThreadPoolExecutor(max_workers=self.threads) as ex:
            futures = [ex.submit(self._check, p) for p in paths]
            done = 0
            for f in concurrent.futures.as_completed(futures):
                done += 1
                progress(f"  Progress: {done}/{total}  "
                         f"Found: {len(self.found)}")
                r = f.result()
                if not r:
                    continue
                self.found.append(r)
                is_sens = any(k in r["url"].lower() for k in SENSITIVE_KEYS)
                print()  # clear progress line
                if r["status"] == 200 and is_sens:
                    sev("High",   f"[200] {r['url']}  ({r['size']}B)  ← SENSITIVE")
                elif r["status"] == 200:
                    sev("Info",   f"[200] {r['url']}  ({r['size']}B)")
                elif r["status"] in (301, 302, 307):
                    sev("Low",    f"[{r['status']}] {r['url']}  (redirect)")
                elif r["status"] == 403:
                    sev("Low",    f"[403] {r['url']}  (forbidden — exists)")
                elif r["status"] == 405:
                    sev("Info",   f"[405] {r['url']}  (method not allowed)")

        print()
        ok(f"Discovery done — {len(self.found)} paths found / {total} tested")
        return self.found


