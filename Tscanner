class Recon:
    def __init__(self, domain: str, target_url: str, stealth: StealthEngine):
        self.domain = domain
        self.target = target_url
        self.stealth = stealth
        self.results = {}

    def run(self) -> dict:
        section("Phase 1 — Reconnaissance")
        self._whois()
        self._dns()
        self._port_scan()
        self._tech_detect()
        return self.results

    # ── WHOIS ─────────────────────────────────────────────────────────────────
    def _whois(self):
        info("WHOIS lookup ...")
        try:
            w = whois.whois(self.domain)
            self.results["whois"] = {
                "registrar":       str(w.registrar),
                "creation_date":   str(w.creation_date),
                "expiration_date": str(w.expiration_date),
                "name_servers":    list(w.name_servers or []),
                "emails":          list(w.emails or []) if isinstance(w.emails, (list, set)) else [str(w.emails or "")],
            }
            ok(f"Registrar : {w.registrar}")
            ok(f"Created   : {w.creation_date}")
            if w.emails:
                ok(f"Email(s)  : {w.emails}")
        except Exception as e:
            warn(f"WHOIS failed: {e}")
            self.results["whois"] = {}

    # ── DNS ───────────────────────────────────────────────────────────────────
    def _dns(self):
        info("DNS enumeration ...")
        self.results["dns"] = {}
        for rtype in ["A", "AAAA", "MX", "NS", "TXT", "CNAME", "SOA"]:
            try:
                records = [str(r) for r in dns.resolver.resolve(self.domain, rtype)]
                self.results["dns"][rtype] = records
                ok(f"{rtype:6s}: {', '.join(records[:3])}")
            except Exception:
                pass

        # subdomain hints from TXT / MX / NS
        subs = set()
        for rtype in ["MX", "NS"]:
            for r in self.results["dns"].get(rtype, []):
                parts = r.split(".")
                if len(parts) > 2:
                    subs.add(parts[0].lower().strip("0123456789"))
        if subs:
            ok(f"Possible subs : {', '.join(list(subs)[:6])}")
            self.results["dns"]["possible_subdomains"] = list(subs)

    # ── PORT SCAN ─────────────────────────────────────────────────────────────
    def _port_scan(self):
        info("Port scan (common ports) ...")
        ports = {
            21:"FTP", 22:"SSH", 23:"Telnet", 25:"SMTP", 53:"DNS",
            80:"HTTP", 110:"POP3", 143:"IMAP", 443:"HTTPS",
            445:"SMB", 3306:"MySQL", 5432:"PostgreSQL",
            6379:"Redis", 8080:"HTTP-Alt", 8443:"HTTPS-Alt",
            8888:"Jupyter", 9200:"Elasticsearch", 27017:"MongoDB",
        }
        host = urlparse(self.target).hostname
        open_ports = {}

        def chk(port, svc):
            try:
                s = socket.socket()
                s.settimeout(0.8)
                if s.connect_ex((host, port)) == 0:
                    s.close()
                    return port, svc
            except Exception:
                pass

        with concurrent.futures.ThreadPoolExecutor(max_workers=40) as ex:
            for f in concurrent.futures.as_completed(
                    {ex.submit(chk, p, s): p for p, s in ports.items()}):
                r = f.result()
                if r:
                    p, s = r
                    open_ports[p] = s
                    lvl = "High" if p in (21,23,3306,27017,6379,9200) else "Info"
                    sev(lvl, f"Open port {p:5d}  ({s})")

        self.results["open_ports"] = open_ports
        if not open_ports:
            warn("No open ports detected")

    # ── TECH DETECTION ────────────────────────────────────────────────────────
    def _tech_detect(self):
        info("Technology fingerprinting ...")
        try:
            sess = self.stealth.make_session()
            r = sess.get(self.target, timeout=10, verify=False, allow_redirects=True)
            h = {k.lower(): v for k, v in r.headers.items()}
            tech = []

            fp_map = {
                "server":         ("Server",   h.get("server", "")),
                "x-powered-by":   ("Backend",  h.get("x-powered-by", "")),
                "x-aspnet":       ("ASP.NET",  h.get("x-aspnet-version", "")),
                "x-generator":    ("CMS",      h.get("x-generator", "")),
            }
            for _, (label, val) in fp_map.items():
                if val:
                    tech.append(f"{label}: {val}")
                    ok(f"Fingerprint — {label}: {val}")

            body = r.text.lower()
            cms_sigs = {
                "WordPress":  ["wp-content", "wp-includes", "wordpress"],
                "Joomla":     ["joomla", "/components/com_"],
                "Drupal":     ["drupal", "/sites/default/"],
                "Laravel":    ["laravel_session", "x-xss-protection"],
                "Django":     ["csrfmiddlewaretoken", "__admin_media_prefix__"],
                "React":      ["react-root", "react.development"],
                "Angular":    ["ng-version", "_nghost"],
            }
            for cms, sigs in cms_sigs.items():
                if any(s in body for s in sigs):
                    tech.append(f"Framework: {cms}")
                    ok(f"Detected — {cms}")

            self.results["technology"] = tech
        except Exception as e:
            warn(f"Tech detect failed: {e}")


