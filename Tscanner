class AIAnalyzer:
    SYS = ("You are a senior penetration tester and security researcher. "
           "Analyze the provided scan results and write a professional "
           "security report in English.")

    def __init__(self, api_key: str = None):
        self.client = anthropic.Anthropic(api_key=api_key) if api_key \
                      else anthropic.Anthropic()

    def analyze(self, findings: dict) -> str:
        section("Phase 5 — AI Analysis (Claude)")
        info("Sending results to Claude AI ...")
        prompt = f"""Analyze the following vulnerability scan results and provide:

1. Executive Summary (2-3 sentences on overall security posture)
2. Top 3 Critical Findings (explain each: what it is, how it can be exploited, CVSS estimate)
3. Remediation Steps (practical code/config fixes for each critical finding)
4. Additional Hardening Recommendations

Scan Results:
```json
{json.dumps(findings, ensure_ascii=False, indent=2)}
```

Write clearly and professionally. Include code snippets where relevant."""

        try:
            msg = self.client.messages.create(
                model="claude-sonnet-4-6",
                max_tokens=2500,
                system=self.SYS,
                messages=[{"role":"user","content":prompt}]
            )
            text = msg.content[0].text
            print(f"\n{Fore.GREEN}{text}{Style.RESET_ALL}")
            return text
        except Exception as e:
            fail(f"Claude API error: {e}")
            return f"Error: {e}"


