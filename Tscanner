def save_report(findings: dict, path: str):
    report = {"tool":"bsam TX VulnScanner","version":"2.5",
              "scan_date":datetime.now().isoformat(),"findings":findings}
    with open(path,"w",encoding="utf-8") as f:
        json.dump(report,f,ensure_ascii=False,indent=2)
    ok(f"Report saved: {path}")


def print_summary(findings: dict, elapsed: int):
    section("Scan Summary")
    web  = findings.get("web_vulns",  [])
    hdrs = findings.get("headers_ssl",[])
    dirs = findings.get("directories",[])
    all_f = web + hdrs

    counts = {s: sum(1 for x in all_f if x.get("severity")==s)
              for s in ("Critical","High","Medium","Low")}

    print(f"  {Fore.RED}Critical : {counts['Critical']:3d}{Style.RESET_ALL}  "
          f"{Fore.LIGHTRED_EX}High   : {counts['High']:3d}{Style.RESET_ALL}  "
          f"{Fore.YELLOW}Medium : {counts['Medium']:3d}{Style.RESET_ALL}  "
          f"{Fore.CYAN}Low  : {counts['Low']:3d}{Style.RESET_ALL}")
    print(f"  Paths found  : {len(dirs)}")
    print(f"  Total issues : {len(all_f)}")
    print(f"  Elapsed      : {elapsed}s")

    if counts["Critical"] > 0:
        print(f"\n  {Fore.RED}[!] CRITICAL issues found — fix immediately!{Style.RESET_ALL}")
    elif counts["High"] > 0:
        print(f"\n  {Fore.YELLOW}[!] HIGH-severity issues found.{Style.RESET_ALL}")
    else:
        print(f"\n  {Fore.GREEN}[+] No critical or high issues detected.{Style.RESET_ALL}")


