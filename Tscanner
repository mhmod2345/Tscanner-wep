class HeadersSSLChecker:
    REQUIRED = {
        "strict-transport-security": ("High",   "HSTS missing — downgrade attack risk"),
        "content-security-policy":   ("High",   "CSP missing — XSS attack surface"),
        "x-frame-options":           ("Medium", "X-Frame-Options missing — clickjacking risk"),
        "x-content-type-options":    ("Low",    "X-Content-Type-Options missing"),
        "referrer-policy":           ("Low",    "Referrer-Policy missing"),
        "permissions-policy":        ("Low",    "Permissions-Policy missing"),
    }

    def __init__(self, target: str, stealth: StealthEngine, timeout: int = 10):
        self.target  = target
        self.stealth = stealth
        self.timeout = timeout
        self.findings = []

    def run(self) -> list:
        section("Phase 4 — Headers & SSL/TLS")
        self._headers()
        self._ssl()
        return self.findings

    def _headers(self):
        info("Checking security headers ...")
        try:
            r = requests.get(self.target,
                             headers=self.stealth.headers(),
                             timeout=self.timeout,
                             verify=False)
            h = {k.lower(): v for k, v in r.headers.items()}

            for hdr, (lvl, msg) in self.REQUIRED.items():
                if hdr not in h:
                    sev(lvl, msg)
                    self.findings.append({"type":"Missing Header","header":hdr,
                                          "severity":lvl,"detail":msg})
                else:
                    ok(f"{hdr}: {h[hdr][:70]}")

            # Information leakage
            for leaky in ("server","x-powered-by","x-aspnet-version","x-generator"):
                if leaky in h:
                    sev("Info", f"{leaky} discloses: {h[leaky]}")
                    self.findings.append({"type":"Info Disclosure","severity":"Low",
                                          "detail":f"{leaky}: {h[leaky]}"})

            # Cookies
            all_set_cookie = r.headers.get("Set-Cookie","")
            if all_set_cookie:
                if "httponly" not in all_set_cookie.lower():
                    sev("Medium","Cookie missing HttpOnly flag")
                    self.findings.append({"type":"Cookie","severity":"Medium",
                                          "detail":"Missing HttpOnly"})
                if "secure" not in all_set_cookie.lower():
                    sev("Medium","Cookie missing Secure flag")
                    self.findings.append({"type":"Cookie","severity":"Medium",
                                          "detail":"Missing Secure"})
                if "samesite" not in all_set_cookie.lower():
                    sev("Low","Cookie missing SameSite flag")

            # CORS
            if "access-control-allow-origin" in h:
                val = h["access-control-allow-origin"]
                if val == "*":
                    sev("Medium","CORS misconfiguration — Access-Control-Allow-Origin: *")
                    self.findings.append({"type":"CORS","severity":"Medium",
                                          "detail":"Wildcard CORS"})

        except Exception as e:
            warn(f"Header check failed: {e}")

    def _ssl(self):
        parsed = urlparse(self.target)
        if parsed.scheme != "https":
            sev("High","Site does not use HTTPS!")
            self.findings.append({"type":"SSL","severity":"High","detail":"No HTTPS"})
            return
        info("Checking SSL/TLS ...")
        try:
            ctx = ssl.create_default_context()
            with ctx.wrap_socket(socket.socket(),
                                 server_hostname=parsed.hostname) as conn:
                conn.settimeout(self.timeout)
                conn.connect((parsed.hostname, 443))
                cert   = conn.getpeercert()
                ver    = conn.version()

            expiry    = datetime.strptime(cert["notAfter"],"%b %d %H:%M:%S %Y %Z")
            days_left = (expiry - datetime.utcnow()).days
            subject   = dict(x[0] for x in cert.get("subject",[]))
            issuer    = dict(x[0] for x in cert.get("issuer", []))
            ok(f"CN       : {subject.get('commonName','N/A')}")
            ok(f"Issuer   : {issuer.get('organizationName','N/A')}")
            ok(f"Protocol : {ver}")

            if days_left < 14:
                sev("Critical",f"Certificate expires in {days_left} days!")
                self.findings.append({"type":"SSL Expiry","severity":"Critical",
                                      "detail":f"Expires in {days_left} days"})
            elif days_left < 30:
                sev("High",    f"Certificate expires in {days_left} days")
            elif days_left < 90:
                sev("Medium",  f"Certificate expires in {days_left} days")
            else:
                ok(f"Certificate valid — expires {expiry.date()} ({days_left}d)")

            if ver in ("TLSv1","TLSv1.1"):
                sev("High", f"Outdated TLS version: {ver}")
                self.findings.append({"type":"Weak TLS","severity":"High","detail":ver})

        except ssl.SSLError as e:
            sev("High",f"SSL error: {e}")
            self.findings.append({"type":"SSL Error","severity":"High","detail":str(e)})
        except Exception as e:
            warn(f"SSL check failed: {e}")


