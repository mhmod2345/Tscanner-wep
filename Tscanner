def main():
    parser = argparse.ArgumentParser(
        description="bsam TX — Web Vulnerability Scanner v2.5",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python scanner.py -u https://testsite.com
  python scanner.py -u https://testsite.com --ai
  python scanner.py -u https://testsite.com --stealth stealth --ai
  python scanner.py -u https://testsite.com -w wordlists/full500.txt -o report.json
  python scanner.py -u https://testsite.com --skip recon headers --stealth ghost
  python scanner.py -u https://testsite.com --threads 40 --timeout 8
        """
    )
    parser.add_argument("-u","--url",      required=True,
                        help="Target URL")
    parser.add_argument("-w","--wordlist", default="wordlists/full500.txt",
                        help="Path to wordlist file")
    parser.add_argument("-o","--output",   default="report.json",
                        help="Output report file (JSON)")
    parser.add_argument("--ai",            action="store_true",
                        help="Enable Claude AI analysis")
    parser.add_argument("--api-key",       help="Anthropic API Key")
    parser.add_argument("--stealth",       default="normal",
                        choices=["normal","stealth","ghost"],
                        help="Stealth level: normal / stealth / ghost")
    parser.add_argument("--threads",       type=int, default=25,
                        help="Directory scan threads (default: 25)")
    parser.add_argument("--timeout",       type=int, default=10,
                        help="Request timeout in seconds (default: 10)")
    parser.add_argument("--skip",          nargs="+", default=[],
                        choices=["recon","web","dirs","headers"],
                        help="Skip specific phases")
    args = parser.parse_args()

    banner()

    if not args.url.startswith(("http://","https://")):
        args.url = "https://" + args.url

    parsed  = urlparse(args.url)
    domain  = parsed.hostname
    start   = datetime.now()
    stealth = StealthEngine(mode=args.stealth)

    print(f"  {Fore.CYAN}Target  :{Style.RESET_ALL} {args.url}")
    print(f"  {Fore.CYAN}Domain  :{Style.RESET_ALL} {domain}")
    print(f"  {Fore.CYAN}Stealth :{Style.RESET_ALL} {args.stealth}")
    print(f"  {Fore.CYAN}Started :{Style.RESET_ALL} {start.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  {Fore.RED}[!] Only use on systems you are authorized to test!{Style.RESET_ALL}")

    all_findings = {"target": args.url}

    if "recon"   not in args.skip:
        all_findings["recon"]        = Recon(domain, args.url, stealth).run()
    if "web"     not in args.skip:
        all_findings["web_vulns"]    = WebVulnScanner(args.url, stealth, args.timeout).run()
    if "dirs"    not in args.skip:
        all_findings["directories"]  = DirScanner(
            args.url, args.wordlist, stealth, args.threads,
            max(3, args.timeout // 2)).run()
    if "headers" not in args.skip:
        all_findings["headers_ssl"]  = HeadersSSLChecker(args.url, stealth, args.timeout).run()
    if args.ai:
        all_findings["ai_analysis"]  = AIAnalyzer(args.api_key).analyze(all_findings)

    elapsed = int((datetime.now() - start).total_seconds())
    print_summary(all_findings, elapsed)
    save_report(all_findings, args.output)


if __name__ == "__main__":
    main()

