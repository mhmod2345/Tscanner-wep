class WebVulnScanner:
    def __init__(self, target: str, stealth: StealthEngine, timeout: int = 10):
        self.target  = target
        self.stealth = stealth
        self.timeout = timeout
        self.findings = []

    def run(self) -> list:
        section("Phase 2 — Web Vulnerability Scan")
        self._xss()
        self._sqli()
        self._open_redirect()
        self._lfi()
        self._csrf()
        self._idor()
        self._ssrf_hints()
        self._cmd_injection()
        return self.findings

    def _get(self, url, params=None, data=None, method="GET"):
        self.stealth.wait()
        sess = self.stealth.make_session()
        try:
            if method == "POST":
                return sess.post(url, data=data, timeout=self.timeout,
                                 verify=False, allow_redirects=False)
            return sess.get(url, params=params, timeout=self.timeout,
                            verify=False, allow_redirects=False)
        except Exception:
            return None

    # ── XSS ──────────────────────────────────────────────────────────────────
    def _xss(self):
        info("Testing XSS ...")
        payloads = [
            "<script>alert(1)</script>",
            "'\"><script>alert(1)</script>",
            "<img src=x onerror=alert(1)>",
            "<svg onload=alert(1)>",
            "javascript:alert(document.cookie)",
        ]
        params = ["q","search","id","name","query","input","text","s","keyword",
                  "term","msg","message","comment","title","page","ref","url"]
        found = False
        for pay in payloads:
            for param in params:
                r = self._get(self.target, {param: pay})
                if r and pay in r.text:
                    sev("High", f"XSS — param={param}  payload={pay[:40]}")
                    self.findings.append({"type":"XSS","severity":"High",
                                          "param":param,"payload":pay,"url":r.url})
                    found = True
        if not found:
            ok("XSS — none found")

    # ── SQLi ─────────────────────────────────────────────────────────────────
    def _sqli(self):
        info("Testing SQL Injection ...")
        payloads = ["'","' OR '1'='1","1 AND SLEEP(2)--","\" OR \"1\"=\"1",
                    "1; DROP TABLE users--","' UNION SELECT NULL--"]
        db_errors = ["sql syntax","mysql_fetch","ora-","syntax error",
                     "unclosed quotation","pg_query","sqlite_","pdoexception",
                     "warning: mysql","you have an error in your sql",
                     "sqlstate","microsoft ole db","odbc drivers"]
        params = ["id","user","username","product","item","category",
                  "page","pid","uid","oid","bid","cid","ref","key"]
        found = False
        for pay in payloads:
            for param in params:
                r = self._get(self.target, {param: pay})
                if r and any(e in r.text.lower() for e in db_errors):
                    sev("Critical", f"SQL Injection — param={param} (DB error exposed)")
                    self.findings.append({"type":"SQLi","severity":"Critical",
                                          "param":param,"payload":pay,"url":r.url})
                    found = True
        if not found:
            ok("SQLi — none found")

    # ── Open Redirect ─────────────────────────────────────────────────────────
    def _open_redirect(self):
        info("Testing Open Redirect ...")
        payloads = ["https://evil.com","//evil.com","/\\evil.com",
                    "https:evil.com","///evil.com"]
        params = ["redirect","url","next","return","goto","continue",
                  "dest","destination","location","redir","target","link"]
        found = False
        for pay in payloads:
            for param in params:
                r = self._get(self.target, {param: pay})
                if r and r.status_code in (301,302) \
                        and "evil.com" in r.headers.get("Location",""):
                    sev("Medium", f"Open Redirect — param={param}")
                    self.findings.append({"type":"Open Redirect","severity":"Medium",
                                          "param":param})
                    found = True
        if not found:
            ok("Open Redirect — none found")

    # ── LFI ──────────────────────────────────────────────────────────────────
    def _lfi(self):
        info("Testing LFI / Path Traversal ...")
        payloads = ["../../../etc/passwd","....//....//etc/passwd",
                    "%2e%2e%2fetc%2fpasswd","..%2f..%2f..%2fetc%2fpasswd",
                    "/etc/passwd%00","....\\....\\....\\windows\\win.ini"]
        params = ["file","page","include","template","path","doc",
                  "load","view","read","fetch","content","f"]
        found = False
        for pay in payloads:
            for param in params:
                r = self._get(self.target, {param: pay})
                if r and ("root:x:" in r.text or "[boot loader]" in r.text
                          or "[fonts]" in r.text):
                    sev("Critical", f"LFI confirmed — param={param}")
                    self.findings.append({"type":"LFI","severity":"Critical",
                                          "param":param,"payload":pay,"url":r.url})
                    found = True
        if not found:
            ok("LFI — none found")

    # ── CSRF ─────────────────────────────────────────────────────────────────
    def _csrf(self):
        info("Testing CSRF ...")
        r = self._get(self.target)
        if r:
            tokens = ["csrf","_token","authenticity_token",
                      "__requestverificationtoken","csrfmiddlewaretoken"]
            if not any(t in r.text.lower() for t in tokens):
                sev("Medium", "No CSRF token found on main page")
                self.findings.append({"type":"CSRF","severity":"Medium",
                                      "detail":"No CSRF token detected"})
            else:
                ok("CSRF token present")

    # ── IDOR ─────────────────────────────────────────────────────────────────
    def _idor(self):
        info("Testing IDOR ...")
        test_ids = [0, 1, 2, 99, 1000, -1]
        params   = ["id","uid","user_id","account","profile","order"]
        baseline = self._get(self.target)
        baseline_len = len(baseline.text) if baseline else 0
        found = False
        for param in params:
            prev = None
            for i in test_ids:
                r = self._get(self.target, {param: i})
                if r and r.status_code == 200:
                    if prev is not None and abs(len(r.text) - prev) > 200:
                        sev("Medium", f"Possible IDOR — param={param} id={i} "
                                      f"(response size changes per ID)")
                        self.findings.append({"type":"IDOR","severity":"Medium",
                                              "param":param,"id":i})
                        found = True
                        break
                    prev = len(r.text) if r else prev
        if not found:
            ok("IDOR — none detected")

    # ── SSRF hints ────────────────────────────────────────────────────────────
    def _ssrf_hints(self):
        info("Testing SSRF hints ...")
        payloads = ["http://127.0.0.1","http://localhost",
                    "http://169.254.169.254/latest/meta-data/"]
        params   = ["url","endpoint","api","fetch","proxy","target","src"]
        found = False
        for pay in payloads:
            for param in params:
                r = self._get(self.target, {param: pay})
                if r and r.status_code == 200 and len(r.text) > 50:
                    sev("High", f"SSRF hint — param={param} responded to internal IP")
                    self.findings.append({"type":"SSRF","severity":"High",
                                          "param":param,"payload":pay})
                    found = True
        if not found:
            ok("SSRF — none detected")

    # ── Command Injection ─────────────────────────────────────────────────────
    def _cmd_injection(self):
        info("Testing Command Injection ...")
        payloads = ["; id", "| id", "`id`", "$(id)", "; sleep 2", "| sleep 2"]
        sigs     = ["uid=","root","www-data","apache","nginx"]
        params   = ["cmd","exec","command","run","shell","ping","ip","host","query"]
        found = False
        for pay in payloads:
            for param in params:
                r = self._get(self.target, {param: pay})
                if r and any(s in r.text for s in sigs):
                    sev("Critical", f"Command Injection — param={param}")
                    self.findings.append({"type":"CMDi","severity":"Critical",
                                          "param":param,"payload":pay})
                    found = True
        if not found:
            ok("Command Injection — none found")


