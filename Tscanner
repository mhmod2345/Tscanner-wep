class StealthEngine:
    """Rotate headers, inject delays, mimic real browser traffic."""

    def __init__(self, mode: str = "normal"):
        """
        mode: 'normal'  — light delay  (0.1–0.5s)
              'stealth' — medium delay  (0.3–1.2s)
              'ghost'   — heavy delay   (0.8–2.5s) — very slow but very quiet
        """
        self.mode = mode
        self._delays = {
            "normal":  (0.05, 0.3),
            "stealth": (0.2,  0.9),
            "ghost":   (0.7,  2.2),
        }

    def headers(self) -> dict:
        return {
            "User-Agent":      random.choice(USER_AGENTS),
            "Accept":          random.choice(ACCEPT_HEADERS),
            "Accept-Language": random.choice(LANGUAGES),
            "Accept-Encoding": "gzip, deflate, br",
            "Connection":      random.choice(["keep-alive", "close"]),
            "Cache-Control":   random.choice(["no-cache", "max-age=0"]),
            "DNT":             "1",
        }

    def wait(self):
        lo, hi = self._delays.get(self.mode, (0.05, 0.3))
        time.sleep(random.uniform(lo, hi))

    def make_session(self) -> requests.Session:
        s = requests.Session()
        s.headers.update(self.headers())
        return s


